# =============================================================================
# TECHJOB ANALYTICS — BACKEND ENVIRONMENT VARIABLES
# =============================================================================
PORT=8000

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# CORS Configuration (comma-separated allowed frontend origins)
# Supports ALLOWED_ORIGINS (standard) or CORS_ORIGINS (alias).
# IMPORTANT: In production, DO NOT use "*". Set your actual frontend domain(s).
# Example: ALLOWED_ORIGINS=https://techjob.ma,https://app.techjob.ma
# For local development:
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Environment identifier (development, staging, production, test)
# Setting this to "production" will:
# - Disable Sentry debug test endpoint
# - Disallow wildcard CORS
# - Enable production sample rates (0.1)
ENVIRONMENT=development

# Sentry Error Tracking & Performance Monitoring
# - Leave empty to disable Sentry (recommended for local development)
# - Set to your Sentry DSN for production error tracking
SENTRY_DSN=

# Sentry Sampling Rates (float 0.0 - 1.0)
# Defaults: 0.1 for production, 1.0 for development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# =============================================================================
# MIGRATION TOOLING ONLY (NOT USED AT RUNTIME)
# =============================================================================
# The following variables are ONLY used by export_and_sync_supabase.py
# to migrate Parquet data to Supabase PostgreSQL for backup/storage purposes.
# They are NOT required for normal application operation.
#
# Runtime Architecture: DuckDB + Parquet (see backend/db.py)
# Migration Documentation: See MIGRATION.md in repository root
#
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# SUPABASE_KEY=[YOUR-ANON-OR-SERVICE-KEY]

